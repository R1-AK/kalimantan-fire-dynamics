# Google Earth Engine Authentication (Optional if using `earthengine authenticate`)
GEE_PROJECT=your-gcp-project-id
GEE_SERVICE_ACCOUNT=your-service-account@your-gcp-project-id.iam.gserviceaccount.com
GEE_PRIVATE_KEY_PATH=/path/to/service-account-key.json

# Local path to KLHK Penutupan Lahan 2025 national GeoTIFF tiles
KLHK_PL2025_TILES_DIR=./data/raw/klhk_pl2025_national_tiles
COAL_PERMITS_GPKG=./data/raw/coal_permits_wiup_2025.gpkg
